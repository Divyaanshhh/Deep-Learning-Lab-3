        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Training Accuracy: 100.0 %\n",
            "\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Predictions\n",
        "print(\"Predictions:\\n\")\n",
        "\n",
        "predictions = model.predict(X, verbose=0)\n",
        "\n",
        "for i in range(len(X)):\n",
        "    output = float(predictions[i][0])\n",
        "    prediction = 1 if output >= 0.5 else 0\n",
        "\n",
        "    print(\"Input:\", X[i])\n",
        "    print(\"Output:\", round(output, 4))\n",
        "    print(\"Prediction:\", prediction)\n",
        "    print()"
